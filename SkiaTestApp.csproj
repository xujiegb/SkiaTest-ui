<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 禁止代码裁剪，确保反射正常（X11 / FrameBuffer host 探测都依赖反射） -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- Uno 核心 -->
    <PackageReference Include="Uno.WinUI" Version="6.6.184" />
    <!-- X11 宿主：有图形会话（X11 或 Wayland 下的 XWayland）时使用 -->
    <PackageReference Include="Uno.WinUI.Skia.X11" Version="6.6.184" />
    <!-- Linux FrameBuffer 宿主：无窗口系统的无头/嵌入式场景兜底 -->
    <PackageReference Include="Uno.WinUI.Skia.Linux.FrameBuffer" Version="6.6.184" />
    <!-- SkiaSharp 引擎及 WinUI/Uno 视图组件 -->
    <PackageReference Include="SkiaSharp" Version="4.152.0-preview.1.1" />
    <PackageReference Include="SkiaSharp.Views.Uno.WinUI" Version="4.152.0-preview.1.1" />
    <!-- 【核心修复】显式锁定原生库版本，防止被其他依赖（或自定义 feed 里
         ppc64le 自编译的旧版本包）传递解析出不匹配的 libSkiaSharp.so。
         必须和上面 SkiaSharp 主包版本号里的 "151" 对应（即 [151.0, 152.0)）。 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0-preview.1.1" />
  </ItemGroup>
</Project>
